# Copy this file to .env and fill in real values. Never commit your real .env file.

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/psit_erp?retryWrites=true&w=majority

# Long random string used to sign JWTs — generate one with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Port the server listens on (most hosts set this automatically)
PORT=5000

# Set to "production" when deployed
NODE_ENV=development

# Restrict CORS to your frontend's domain in production, e.g. https://yourname.github.io
CORS_ORIGIN=*

# Only for local testing: when NODE_ENV=production, "Forgot password" no longer shows the reset
# token on screen (otherwise anyone could reset any account). Set to true to override — not recommended.
ALLOW_DEV_RESET=false

# Used by seed.js — and automatically on server start if no admin exists yet — to create the first admin
SEED_ADMIN_EMAIL=admin@psit.ac.in
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Super Admin
